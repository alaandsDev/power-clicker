--[[
	Economy rule tests on real PlayerData templates (no Players, no DataStore).
]]

local Server = script.Parent.Parent.Parent
local Shared = game:GetService("ReplicatedStorage").Shared
local CurrencyLogic = require(Server.Logic.CurrencyLogic)
local UpgradeLogic = require(Server.Logic.UpgradeLogic)
local RebirthLogic = require(Server.Logic.RebirthLogic)
local DataTemplate = require(Server.Services.DataService.DataTemplate)
local EconomyFormulas = require(Shared.Formulas.EconomyFormulas)
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local RebirthConfig = require(Shared.Config.RebirthConfig)
local GameConfig = require(Shared.Config.GameConfig)

local function fresh()
	return DataTemplate.Create(0)
end

return function(T)
	T.describe("CurrencyLogic", function()
		T.it("adds, tracks earned stat and removes", function()
			local data = fresh()
			T.expect(CurrencyLogic.Add(data, "Power", 100)).toBe(100)
			T.expect(data.Stats.TotalPowerEarned).toBe(100)
			T.expect(CurrencyLogic.Remove(data, "Power", 40)).toBe(true)
			T.expect(CurrencyLogic.Get(data, "Power")).toBe(60)
		end)
		T.it("rejects invalid amounts (negative, zero, NaN, inf, strings)", function()
			local data = fresh()
			for _, bad in { -5, 0, 0 / 0, math.huge, "10" } do
				T.expect(CurrencyLogic.Add(data, "Power", bad :: any)).toBe(0)
				T.expect(CurrencyLogic.Remove(data, "Power", bad :: any)).toBe(false)
			end
			T.expect(CurrencyLogic.Get(data, "Power")).toBe(0)
		end)
		T.it("rejects unknown currencies", function()
			local data = fresh()
			T.expect(CurrencyLogic.Add(data, "Robux" :: any, 10)).toBe(0)
		end)
		T.it("never goes negative: removing more than balance removes nothing", function()
			local data = fresh()
			CurrencyLogic.Add(data, "Gems", 10)
			T.expect(CurrencyLogic.Remove(data, "Gems", 11)).toBe(false)
			T.expect(CurrencyLogic.Get(data, "Gems")).toBe(10)
		end)
		T.it("caps at MaxValue", function()
			local data = fresh()
			CurrencyLogic.Add(data, "Power", GameConfig.Numbers.MaxValue)
			T.expect(CurrencyLogic.Add(data, "Power", 1e99)).toBe(0)
			T.expect(CurrencyLogic.Get(data, "Power")).toBe(GameConfig.Numbers.MaxValue)
		end)
		T.it("sanitizes corrupted stored balances on read", function()
			local data = fresh()
			data.Currencies.Power = 0 / 0
			T.expect(CurrencyLogic.Get(data, "Power")).toBe(0)
		end)
	end)

	T.describe("UpgradeLogic", function()
		local id = "ClickStrength"
		local upgrade = UpgradeConfig.Temporary[id]

		T.it("fails without funds and charges nothing", function()
			local data = fresh()
			local ok, code = UpgradeLogic.Purchase(data, id)
			T.expect(ok).toBe(false)
			T.expect(code).toBe("NotEnoughCurrency")
			T.expect(UpgradeLogic.GetLevel(data, id)).toBe(0)
		end)
		T.it("charges the server-computed cost and levels up", function()
			local data = fresh()
			CurrencyLogic.Add(data, "Power", 1000)
			local cost = EconomyFormulas.UpgradeCost(upgrade, 0)
			local ok, _, level, charged = UpgradeLogic.Purchase(data, id)
			T.expect(ok).toBe(true)
			T.expect(level).toBe(1)
			T.expect(charged).toBe(cost)
			T.expect(CurrencyLogic.Get(data, "Power")).toBe(1000 - cost)
		end)
		T.it("stops at MaxLevel", function()
			local data = fresh()
			data.Upgrades[id] = upgrade.MaxLevel
			CurrencyLogic.Add(data, "Power", GameConfig.Numbers.MaxValue)
			local ok, code = UpgradeLogic.Purchase(data, id)
			T.expect(ok).toBe(false)
			T.expect(code).toBe("MaxLevel")
		end)
		T.it("unknown upgrade is rejected", function()
			local ok, code = UpgradeLogic.Purchase(fresh(), "FreeMoney")
			T.expect(ok).toBe(false)
			T.expect(code).toBe("UnknownUpgrade")
		end)
		T.it("permanent upgrades cost Gems and go to PermanentUpgrades", function()
			local data = fresh()
			CurrencyLogic.Add(data, "Power", 1e12)
			T.expect((UpgradeLogic.Purchase(data, "GemPower"))).toBe(false)
			CurrencyLogic.Add(data, "Gems", 1000)
			T.expect((UpgradeLogic.Purchase(data, "GemPower"))).toBe(true)
			T.expect(data.PermanentUpgrades.GemPower).toBe(1)
		end)
		T.it("corrupted levels are treated as 0", function()
			local data = fresh()
			data.Upgrades[id] = -7
			T.expect(UpgradeLogic.GetLevel(data, id)).toBe(0)
			data.Upgrades[id] = 0 / 0
			T.expect(UpgradeLogic.GetLevel(data, id)).toBe(0)
		end)
		T.it("effects sum per group", function()
			local data = fresh()
			data.Upgrades.ClickStrength = 5
			data.Upgrades.PowerBoost = 2
			T.expect(UpgradeLogic.GetEffect(data, "Temporary", "ClickPowerFlat")).toBe(5 * upgrade.EffectPerLevel)
			T.expect(UpgradeLogic.GetEffect(data, "Temporary", "PowerMultiplier")).toBeNear(2 * UpgradeConfig.Temporary.PowerBoost.EffectPerLevel)
			T.expect(UpgradeLogic.GetEffect(data, "Permanent", "PowerMultiplier")).toBe(0)
		end)
	end)

	T.describe("RebirthLogic", function()
		T.it("refuses without the requirement and changes nothing", function()
			local data = fresh()
			CurrencyLogic.Add(data, "Power", RebirthConfig.BaseCost - 1)
			local ok, code = RebirthLogic.Perform(data)
			T.expect(ok).toBe(false)
			T.expect(code).toBe("NotEnoughCurrency")
			T.expect(data.Stats.Rebirths).toBe(0)
			T.expect(CurrencyLogic.Get(data, "Power")).toBe(RebirthConfig.BaseCost - 1)
		end)
		T.it("resets Power and temporary upgrades, keeps permanent ones, grants Gems", function()
			local data = fresh()
			data.Upgrades.ClickStrength = 10
			data.PermanentUpgrades.GemPower = 3
			CurrencyLogic.Add(data, "Power", RebirthConfig.BaseCost * 2)
			local ok, _, result = RebirthLogic.Perform(data)
			T.expect(ok).toBe(true)
			T.expect(result.Rebirths).toBe(1)
			T.expect(result.Gems).toBe(EconomyFormulas.RebirthGems(0))
			T.expect(CurrencyLogic.Get(data, "Power")).toBe(0)
			T.expect(data.Upgrades.ClickStrength).toBeNil()
			T.expect(data.PermanentUpgrades.GemPower).toBe(3)
			T.expect(CurrencyLogic.Get(data, "Gems")).toBe(EconomyFormulas.RebirthGems(0))
		end)
		T.it("multiple rebirths follow the growing cost", function()
			local data = fresh()
			for expected = 1, 5 do
				CurrencyLogic.Add(data, "Power", RebirthLogic.GetCost(data))
				local ok = RebirthLogic.Perform(data)
				T.expect(ok).toBe(true)
				T.expect(data.Stats.Rebirths).toBe(expected)
			end
			-- Paying the previous cost is no longer enough.
			CurrencyLogic.Add(data, "Power", EconomyFormulas.RebirthCost(4))
			T.expect((RebirthLogic.Perform(data))).toBe(false)
		end)
		T.it("respects MaxRebirths", function()
			local data = fresh()
			data.Stats.Rebirths = RebirthConfig.MaxRebirths
			CurrencyLogic.Add(data, "Power", GameConfig.Numbers.MaxValue)
			local ok, code = RebirthLogic.Perform(data)
			T.expect(ok).toBe(false)
			T.expect(code).toBe("MaxRebirths")
		end)
	end)
end
