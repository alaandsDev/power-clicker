local Shared = game:GetService("ReplicatedStorage").Shared
local NumberFormat = require(Shared.Utils.NumberFormat)
local ComboLogic = require(Shared.Formulas.ComboLogic)
local PowerFormula = require(Shared.Formulas.PowerFormula)
local ComboConfig = require(Shared.Config.ComboConfig)
local GameConfig = require(Shared.Config.GameConfig)

return function(T)
	T.describe("NumberFormat", function()
		T.it("short suffixes", function()
			T.expect(NumberFormat.Short(0)).toBe("0")
			T.expect(NumberFormat.Short(999)).toBe("999")
			T.expect(NumberFormat.Short(1234)).toBe("1.23K")
			T.expect(NumberFormat.Short(1500000)).toBe("1.5M")
			T.expect(NumberFormat.Short(2e9)).toBe("2B")
			T.expect(NumberFormat.Short(-1234)).toBe("-1.23K")
			T.expect(NumberFormat.Short(12.5)).toBe("12.5")
		end)
		T.it("rounds up to the next tier instead of 1000K", function()
			T.expect(NumberFormat.Short(999999)).toBe("1M")
		end)
		T.it("scientific beyond suffixes, safe on NaN/inf", function()
			T.expect(NumberFormat.Short(1e40)).toBe("1.00e40")
			T.expect(NumberFormat.Short(0 / 0)).toBe("0")
			T.expect(NumberFormat.Short(math.huge)).toBe("∞")
		end)
		T.it("commas and durations", function()
			T.expect(NumberFormat.Commas(1234567)).toBe("1,234,567")
			T.expect(NumberFormat.Commas(123456)).toBe("123,456")
			T.expect(NumberFormat.Commas(12)).toBe("12")
			T.expect(NumberFormat.Duration(65)).toBe("1:05")
			T.expect(NumberFormat.Duration(3600)).toBe("1:00:00")
			T.expect(NumberFormat.Duration(-5)).toBe("0:00")
		end)
	end)

	T.describe("ComboLogic", function()
		T.it("adds a stack per click up to the cap", function()
			local stacks, at = 0, 0
			for i = 1, ComboConfig.MaxStacks + 20 do
				local now = i * 0.1
				stacks = ComboLogic.Register(stacks, at, now)
				at = now
			end
			T.expect(stacks).toBe(ComboConfig.MaxStacks)
		end)
		T.it("keeps stacks within the timeout", function()
			T.expect(ComboLogic.Current(10, 0, ComboConfig.TimeoutSeconds)).toBe(10)
		end)
		T.it("decays after the timeout and never goes negative", function()
			local afterOneSecond = ComboLogic.Current(40, 0, ComboConfig.TimeoutSeconds + 1)
			T.expect(afterOneSecond).toBe(math.max(0, 40 - math.floor(ComboConfig.DecayStacksPerSecond)))
			T.expect(ComboLogic.Current(40, 0, 1e6)).toBe(0)
		end)
	end)

	T.describe("PowerFormula", function()
		T.it("multiplies base by every layer", function()
			local power, total = PowerFormula.Compute(10, { Upgrade = 2, Rebirth = 1.5, Combo = 2 })
			T.expect(power).toBeNear(60)
			T.expect(total).toBeNear(6)
		end)
		T.it("ignores unknown layers and invalid values instead of breaking", function()
			local power, _, problems = PowerFormula.Compute(10, { Upgrade = 2, Hacked = 1000, Pet = 0 / 0, World = -5, Overdrive = math.huge })
			T.expect(power).toBeNear(20)
			T.expect(#problems).toBe(4)
		end)
		T.it("invalid base yields 0, never NaN", function()
			T.expect((PowerFormula.Compute(0 / 0, { Upgrade = 2 }))).toBe(0)
			T.expect((PowerFormula.Compute(-5, { Upgrade = 2 }))).toBe(0)
		end)
		T.it("caps at MaxValue", function()
			local power = PowerFormula.Compute(1e90, { Upgrade = 1e20, Rebirth = 1e20 })
			T.expect(power).toBe(GameConfig.Numbers.MaxValue)
		end)
	end)
end
