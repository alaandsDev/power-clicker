local Guard = require(game:GetService("ReplicatedStorage").Shared.Utils.Guard)

return function(T)
	T.describe("Guard", function()
		T.it("IsFiniteNumber rejects NaN, inf and non-numbers", function()
			T.expect(Guard.IsFiniteNumber(1)).toBe(true)
			T.expect(Guard.IsFiniteNumber(0 / 0)).toBe(false)
			T.expect(Guard.IsFiniteNumber(math.huge)).toBe(false)
			T.expect(Guard.IsFiniteNumber(-math.huge)).toBe(false)
			T.expect(Guard.IsFiniteNumber("1")).toBe(false)
			T.expect(Guard.IsFiniteNumber(nil)).toBe(false)
		end)

		T.it("Integer enforces range and integrality", function()
			local check = Guard.Integer(1, 10)
			T.expect(check(1)).toBe(true)
			T.expect(check(10)).toBe(true)
			T.expect(check(0)).toBe(false)
			T.expect(check(11)).toBe(false)
			T.expect(check(1.5)).toBe(false)
			T.expect(check(-5)).toBe(false)
			T.expect(check(1e308)).toBe(false)
			T.expect(check(0 / 0)).toBe(false)
		end)

		T.it("String enforces type, length and UTF-8", function()
			local check = Guard.String(5)
			T.expect(check("abc")).toBe(true)
			T.expect(check("abcdef")).toBe(false)
			T.expect(check(123)).toBe(false)
			T.expect(check("\255\254")).toBe(false)
		end)

		T.it("KeyOf only accepts existing keys", function()
			local check = Guard.KeyOf({ BasicEgg = {} })
			T.expect(check("BasicEgg")).toBe(true)
			T.expect(check("FakeEgg")).toBe(false)
			T.expect(check({})).toBe(false)
			T.expect(check(nil)).toBe(false)
		end)

		T.it("OneOf / Boolean / Optional", function()
			T.expect(Guard.OneOf({ "A", "B" })("A")).toBe(true)
			T.expect(Guard.OneOf({ "A", "B" })("C")).toBe(false)
			T.expect(Guard.Boolean()(false)).toBe(true)
			T.expect(Guard.Boolean()(0)).toBe(false)
			T.expect(Guard.Optional(Guard.Integer(1, 2))(nil)).toBe(true)
			T.expect(Guard.Optional(Guard.Integer(1, 2))(3)).toBe(false)
		end)

		T.it("Args validates positions and rejects extra arguments", function()
			local validate = Guard.Args(Guard.String(10), Guard.Integer(1, 5))
			T.expect(validate("x", 3)).toBe(true)
			T.expect(validate("x")).toBe(false)
			T.expect(validate(3, "x")).toBe(false)
			T.expect(validate("x", 3, "extra")).toBe(false)
			T.expect(Guard.Args()()).toBe(true)
			T.expect(Guard.Args()(1)).toBe(false)
		end)
	end)
end
